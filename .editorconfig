# EditorConfig — https://editorconfig.org
# Baseline whitespace conventions across the monorepo. Style enforcement for the JVM
# modules is done mechanically by Spotless (see each module's build.gradle); this file
# is what IDEs and other editors read.

root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

# JVM code and Gradle build scripts — tab-indented house style, displayed 4 wide.
[*.{java,gradle}]
indent_style = tab
tab_width = 4

# Studio (Vue 3 / Vite) — space-indented, 4.
[*.{vue,js,cjs,mjs,ts}]
indent_style = space
indent_size = 4

# Data / config / markup — space-indented, 2.
[*.{yml,yaml,json,jsonc,xml,html,css,toml,properties}]
indent_style = space
indent_size = 2

# Markdown — 2-space, and keep trailing whitespace (hard line breaks).
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Generated / vendored — leave alone.
[{**/node_modules/**,**/build/**,**/dist/**,**/.gradle/**}]
charset = unset
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
indent_style = unset
indent_size = unset
